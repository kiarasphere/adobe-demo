# Datadog Browser RUM + Logs (US5). Export these before `yarn start`, or
# copy values into your shell — never commit secrets.
# See examples/datadog/.env.example for the full variable list.
# Canonical service: adobe-demo
#
# webpack DefinePlugin reads process.env at build/start time.

DD_SERVICE=adobe-demo
DD_ENV=dev
DD_VERSION=1.0.0
DD_SITE=us5.datadoghq.com
DD_APPLICATION_ID=your_rum_application_id
DD_CLIENT_TOKEN=your_datadog_client_token
