# Datadog Browser RUM + Logs (US5). Copy to .env in an example app (or export
# in your shell) and fill in — never commit secrets.
# Site: https://us5.datadoghq.com
#
# Canonical service name (confirmed: no prior DD_SERVICE in this repo): adobe-demo

DD_SERVICE=adobe-demo
DD_ENV=dev
DD_VERSION=1.0.0
DD_SITE=us5.datadoghq.com

# Create a RUM application in Datadog US5 (Digital Experience → Add Application).
# Client token is safe for browsers but still treat as non-public in git.
DD_APPLICATION_ID=your_rum_application_id
DD_CLIENT_TOKEN=your_datadog_client_token

# Optional
# DD_SESSION_SAMPLE_RATE=100
# DD_RUM_ENABLED=true

# CRA (examples/rsp-cra-18) requires the REACT_APP_ prefix — same values:
REACT_APP_DD_SERVICE=adobe-demo
REACT_APP_DD_ENV=dev
REACT_APP_DD_VERSION=1.0.0
REACT_APP_DD_SITE=us5.datadoghq.com
REACT_APP_DD_APPLICATION_ID=your_rum_application_id
REACT_APP_DD_CLIENT_TOKEN=your_datadog_client_token
